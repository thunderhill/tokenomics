{
  "name": "@tokenomics/sdk",
  "version": "0.1.0",
  "description": "Emit OpenTelemetry GenAI spans with cost attribution to Tokenomics",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
